{
  "name": "pourover-wizard",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=26.10.0 <27",
    "npm": ">=12.2.0 <13"
  },
  "packageManager": "npm@12.2.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.core.json && node scripts/check-core.mjs",
    "architecture": "depcruise src --config .dependency-cruiser.cjs && node scripts/check-bluetooth.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:fast": "run-p --max-parallel 2 --continue-on-error --print-label typecheck lint architecture test",
    "test:e2e": "npm run build && playwright test",
    "check": "run-p --max-parallel 2 --continue-on-error --print-label check:fast test:e2e quality:report && node scripts/record-check.mjs",
    "test:coverage": "vitest run --coverage --outputFile.junit=reports/unit-coverage.xml",
    "test:mutation": "stryker run",
    "test:mutation:full": "stryker run --force",
    "report:complexity": "node scripts/report-complexity.mjs",
    "report:crap": "node scripts/report-crap.mjs",
    "quality:report": "run-s test:coverage report:complexity report:crap",
    "build:ios": "vite build --base / --outDir dist-ios",
    "ios:sync": "npm run build:ios && cap sync ios",
    "ios:package": "npm run ios:sync && node scripts/package-ios.mjs"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "8.3.0",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@capacitor/cli": "8.5.2",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "8.71.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "npm-run-all2": "9.0.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "6.16.0"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
